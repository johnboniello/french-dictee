<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="Prends en photo la liste de mots. Ça marche mieux avec un mot par ligne, bien à plat et bien éclairé."
            android:textSize="15sp" />

        <Button
            android:id="@+id/photoBtn"
            style="@style/Widget.Dictee.Button.Blue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:text="📷  Prendre une photo"
            android:textSize="18sp" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/hintText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="4dp"
            android:text="Les mots trouvés apparaîtront ici pour que tu les vérifies."
            android:textSize="14sp" />

        <EditText
            android:id="@+id/reviewField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="un mot par ligne"
            android:inputType="textMultiLine|textNoSuggestions"
            android:minLines="6" />

        <Button
            android:id="@+id/addBtn"
            style="@style/Widget.Dictee.Button.Gold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Ajouter à la liste" />
    </LinearLayout>
</ScrollView>
